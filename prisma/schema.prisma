// Production schema (PostgreSQL / Vercel). Local development automatically uses a SQLite copy of this
// file generated by scripts/prepare-db.mjs, so keep this file provider-neutral (no native DB types).
//
// DEPLOYING SAFELY: all current models live in NEW tables (ss_*). The Legacy* models at the bottom describe
// the tables of the previous version of the app *exactly as they were*, so `prisma db push` never alters or
// drops them. Nothing in production is destroyed by a deploy, and rolling back is just redeploying the old commit.
// Once you are sure you no longer need the old data, delete the Legacy* models and drop those tables by hand.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Room {
  id           String       @id @default(cuid())
  code         String       @unique
  activeGame   String? // game id from src/games/registry.ts, null = game menu
  gameState    String? // JSON, owned by the active game engine
  version      Int          @default(1) // bumped on every change; clients poll it cheaply
  stats        String       @default("{}") // JSON counters used for badges
  anniversary  String? // yyyy-mm-dd
  tz           String       @default("Asia/Kolkata") // decides when "today" starts for Daily Spark
  streak       Int          @default(0)
  bestStreak   Int          @default(0)
  lastSparkDay String? // yyyy-mm-dd of the last day both partners completed the Daily Spark
  freezes      Int          @default(1) // a freeze saves the streak if one day is missed
  createdAt    DateTime     @default(now())
  lastActiveAt DateTime     @default(now())
  users        User[]
  gifts        Gift[]
  coupons      Coupon[]
  bucket       BucketItem[]
  sparks       Spark[]

  @@map("ss_room")
}

model User {
  id              String   @id @default(cuid())
  roomId          String
  name            String
  avatar          String   @default("🐻")
  points          Int      @default(0)
  joinedAt        DateTime @default(now())
  room            Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  giftsSent       Gift[]   @relation("GiftSender")
  giftsReceived   Gift[]   @relation("GiftReceiver")
  couponsSent     Coupon[] @relation("CouponFrom")
  couponsReceived Coupon[] @relation("CouponTo")

  @@map("ss_user")
}

model Gift {
  id         String   @id @default(cuid())
  roomId     String
  senderId   String
  receiverId String
  type       String // FLOWER | HUG | CHOCOLATE | KISS | COFFEE | TEDDY | MISS_YOU | NOTE
  content    String?
  seen       Boolean  @default(false)
  createdAt  DateTime @default(now())
  room       Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  sender     User     @relation("GiftSender", fields: [senderId], references: [id], onDelete: Cascade)
  receiver   User     @relation("GiftReceiver", fields: [receiverId], references: [id], onDelete: Cascade)

  @@index([roomId, createdAt])

  @@map("ss_gift")
}

model Coupon {
  id         String    @id @default(cuid())
  roomId     String
  fromId     String
  toId       String
  title      String
  emoji      String    @default("🎟️")
  note       String?
  redeemedAt DateTime?
  createdAt  DateTime  @default(now())
  room       Room      @relation(fields: [roomId], references: [id], onDelete: Cascade)
  from       User      @relation("CouponFrom", fields: [fromId], references: [id], onDelete: Cascade)
  to         User      @relation("CouponTo", fields: [toId], references: [id], onDelete: Cascade)

  @@index([roomId, createdAt])

  @@map("ss_coupon")
}

model BucketItem {
  id        String    @id @default(cuid())
  roomId    String
  text      String
  emoji     String    @default("✨")
  done      Boolean   @default(false)
  addedById String
  doneAt    DateTime?
  createdAt DateTime  @default(now())
  room      Room      @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@index([roomId, createdAt])

  @@map("ss_bucket")
}

model Spark {
  id          String    @id @default(cuid())
  roomId      String
  day         String // yyyy-mm-dd in the room's timezone
  promptId    String
  answers     String    @default("{}") // JSON { userId: answer }, never sent to a partner before both answered
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  room        Room      @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@unique([roomId, day])

  @@map("ss_spark")
}

model GamePlay {
  game  String @id
  count Int    @default(0)

  @@map("ss_game_play")
}

// ------------------------------ LEGACY (previous app version, unused) ------------------------------

model LegacyRoom {
  id                String       @id @default(cuid())
  activeGame        String       @default("QUIZ")
  gameMode          String       @default("ROMANTIC")
  activeQuestionIds String?
  todState          String?
  createdAt         DateTime     @default(now())
  users             LegacyUser[]

  @@map("Room")
}

model LegacyUser {
  id              String         @id @default(cuid())
  roomId          String
  name            String
  points          Int            @default(0)
  joinedAt        DateTime       @default(now())
  room            LegacyRoom     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  answers         LegacyAnswer[]
  actionsSent     LegacyAction[] @relation("ActionSender")
  actionsReceived LegacyAction[] @relation("ActionReceiver")

  @@map("User")
}

model LegacyQuestion {
  id       String         @id @default(cuid())
  text     String
  category String         @default("ROMANTIC")
  options  String
  order    Int
  answers  LegacyAnswer[]

  @@map("Question")
}

model LegacyTruthOrDareCard {
  id       String @id @default(cuid())
  type     String
  category String @default("FUN")
  text     String

  @@map("TruthOrDareCard")
}

model LegacyAnswer {
  id         String         @id @default(cuid())
  userId     String
  questionId String
  answerText String
  createdAt  DateTime       @default(now())
  user       LegacyUser     @relation(fields: [userId], references: [id], onDelete: Cascade)
  question   LegacyQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([userId, questionId])
  @@map("Answer")
}

model LegacyAction {
  id         String     @id @default(cuid())
  senderId   String
  receiverId String
  type       String
  content    String?
  createdAt  DateTime   @default(now())
  sender     LegacyUser @relation("ActionSender", fields: [senderId], references: [id], onDelete: Cascade)
  receiver   LegacyUser @relation("ActionReceiver", fields: [receiverId], references: [id], onDelete: Cascade)

  @@map("Action")
}
