// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Room {
  id                String   @id @default(cuid())
  activeGame        String   @default("QUIZ")     // "QUIZ" | "TRUTH_OR_DARE"
  gameMode          String   @default("ROMANTIC") // Category for Quiz
  activeQuestionIds String?  // JSON string array of current 5 question IDs
  todState          String?  // JSON string state for active Truth or Dare turn
  createdAt         DateTime @default(now())
  users             User[]
}

model User {
  id              String   @id @default(cuid())
  roomId          String
  name            String
  points          Int      @default(0)
  joinedAt        DateTime @default(now())
  room            Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  answers         Answer[]
  actionsSent     Action[] @relation("ActionSender")
  actionsReceived Action[] @relation("ActionReceiver")
}

model Question {
  id       String   @id @default(cuid())
  text     String
  category String   @default("ROMANTIC")
  options  String   // JSON stringified array of options
  order    Int
  answers  Answer[]
}

model TruthOrDareCard {
  id       String @id @default(cuid())
  type     String // "TRUTH" | "DARE"
  category String @default("FUN") // "ROMANTIC" | "FUN" | "SPICY"
  text     String
}

model Answer {
  id         String   @id @default(cuid())
  userId     String
  questionId String
  answerText String
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([userId, questionId])
}

model Action {
  id         String   @id @default(cuid())
  senderId   String
  receiverId String
  type       String   // 'FLOWER', 'HUG', 'NOTE', 'CHOCOLATE', 'KISS', 'COFFEE'
  content    String?
  createdAt  DateTime @default(now())
  sender     User     @relation("ActionSender", fields: [senderId], references: [id], onDelete: Cascade)
  receiver   User     @relation("ActionReceiver", fields: [receiverId], references: [id], onDelete: Cascade)
}
